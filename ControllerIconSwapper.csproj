<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ControllerIconSwapper</AssemblyName>
    <Product>Controller Icon Swapper</Product>
    <Version>1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>ControllerIconSwapper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FrameworkBridge\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="5.6.0" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2\GraveyardKeeper2_Data\Managed\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="LazyBearTechnology">
			<HintPath>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2\GraveyardKeeper2_Data\Managed\LazyBearTechnology.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="netstandard">
			<HintPath>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2\GraveyardKeeper2_Data\Managed\netstandard.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2\GraveyardKeeper2_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Reference Update="mscorlib">
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<Target Name="ZipPlugin" AfterTargets="PostBuildEvent">
		<!-- Define output directory and zip path -->
		<PropertyGroup>
			<PluginName>$(AssemblyName)</PluginName>
			<ZipOutputDir>$(SolutionDir)Builds</ZipOutputDir>
			<ZipFilePath>$(ZipOutputDir)\$(PluginName)_v$(Version).zip</ZipFilePath>
			<StagingDir>$(IntermediateOutputPath)ZipStaging\BepInEx\plugins\$(PluginName)</StagingDir>
		</PropertyGroup>

		<!-- Create clean staging folder and output folder -->
		<MakeDir Directories="$(ZipOutputDir)" />
		<RemoveDir Directories="$(IntermediateOutputPath)ZipStaging" />
		<MakeDir Directories="$(StagingDir)" />

		<!-- Copy the compiled DLL to the staging directory -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingDir)" />

		<!-- Delete old zip if it exists, then create the new zip -->
		<Delete Files="$(ZipFilePath)" Condition="Exists('$(ZipFilePath)')" />
		<ZipDirectory SourceDirectory="$(IntermediateOutputPath)ZipStaging" DestinationFile="$(ZipFilePath)" />

		<!-- Log message in build console -->
		<Message Text="[Post-Build] Created release zip at: $(ZipFilePath)" Importance="high" />
	</Target>
</Project>
